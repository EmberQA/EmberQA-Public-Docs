{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "EmberQA Documentation",
  "colors": {
    "primary": "#8350ff",
    "light": "#d3a3ff",
    "dark": "#6052ff"
  },
  "appearance": { "default": "light" },
  "favicon": "/favicon.svg",
  "api": {
    "mdx": {
      "server": "https://api.emberqa.com/api",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "php",
        "java",
        "go",
        "ruby"
      ],
      "defaults": "all",
      "prefill": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Using the App",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["app-guide/overview", "app-guide/getting-started"]
          },
          {
            "group": "Operations",
            "pages": [
              "app-guide/dashboard",
              "app-guide/daily-reports",
              "app-guide/workflows"
            ]
          },
          {
            "group": "Performance",
            "pages": [
              "app-guide/analytics",
              "app-guide/coaching",
              "app-guide/training",
              "app-guide/monitoring"
            ]
          },
          {
            "group": "Standards",
            "pages": [
              "app-guide/rubrics",
              "app-guide/red-flags",
              "app-guide/alerts"
            ]
          },
          {
            "group": "Ingestion",
            "pages": ["app-guide/upload"]
          },
          {
            "group": "Settings",
            "pages": [
              "app-guide/users",
              "app-guide/agent-management",
              "app-guide/teams",
              "app-guide/metadata",
              "app-guide/scoring",
              "app-guide/billing"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "/api-reference/openapi.json",
        "groups": [
          {
            "group": "API documentation",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Scoring",
            "pages": [
              {
                "group": "Calls",
                "pages": [
                  "/api-reference/openapi-call-audio-url.json POST /scoring/submitRecording",
                  "/api-reference/openapi-call-audio-upload.json POST /scoring/submitRecording"
                ]
              },
              {
                "group": "Documents",
                "pages": ["POST /scoring/submitDocument"]
              }
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              {
                "group": "Workflow Runs",
                "pages": [
                  "POST /workflows/submit",
                  "POST /workflows/runs/getData",
                  "POST /workflows/runs/getDetails"
                ]
              },
              {
                "group": "Extraction Templates",
                "pages": [
                  "POST /workflows/extractionTemplates/getById",
                  "POST /workflows/extractionTemplates/getAll"
                ]
              }
            ]
          },
          {
            "group": "Webhooks",
            "pages": ["webhooks"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.emberqa.com",
          "icon": "globe"
        },
        {
          "anchor": "News",
          "href": "https://emberqa.com/news",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@emberqa.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.emberqa.com"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.emberqa.com"
    }
  },

  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/emberqa"
    }
  }
}
