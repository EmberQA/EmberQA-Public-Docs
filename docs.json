{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "EmberQA Documentation",
  "colors": {
    "primary": "#8350ff",
    "light": "#d3a3ff",
    "dark": "#6052ff"
  },
  "appearance": { "default": "light" },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "API reference",
        "openapi": "/api-reference/openapi.json",
        "groups": [
          {
            "group": "API documentation",
            "pages": ["api-reference/introduction"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.emberqa.com",
          "icon": "globe"
        },
        {
          "anchor": "News",
          "href": "https://emberqa.com/news",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@emberqa.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.emberqa.com"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.emberqa.com"
    }
  },

  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/emberqa"
    }
  }
}
